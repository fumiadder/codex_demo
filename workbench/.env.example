# Copy once to /srv/zhixu/shared/.env on the authorized server; never commit .env.
# Project/volume names MUST stay stable across all releases.
COMPOSE_PROJECT_NAME=zhixu
WORKSPACE_DATA_VOLUME=zhixu_data
WORKSPACE_DOMAIN=workbench.example.com
# Optional authorized mirror images if the server cannot pull official images.
CADDY_IMAGE=caddy:2-alpine
MAX_SPACE_STORAGE_BYTES=1073741824
MAX_TOTAL_STORAGE_BYTES=10737418240

# Optional cloud storage; empty DATABASE_URL keeps the local SQLite volume.
# Render + Neon setup and migration: docs/neon-migration.md.
DATABASE_URL=
# native uses certificate-verified PostgreSQL TCP. neon-ws uses verified WSS
# to the direct Neon hostname; its explicit profile omits channel_binding=require.
# Both preserve PostgreSQL transactions; see docs/neon-migration.md.
DATABASE_TRANSPORT=native
MEDIA_STORAGE_BACKEND=local
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_UPLOADS_BUCKET=uploads
AWS_BEDTIME_AUDIO_BUCKET=bedtime-audio

# Optional bedtime providers. Defaults are local stories and device voices.
# Keep keys only in server shared/.env; no key means cloud features unavailable.
# Configuring a provider may incur its own usage charges when invoked.
# Use an account with valid model quota on the fixed Mainland-China endpoint.
# Model selection never falls back automatically if a request fails.
# Existing installations default to enabled; set flags to 0 for staged setup.
DASHSCOPE_API_KEY=
STORY_GENERATION_MODEL=qwen-plus
STORY_GENERATION_ENABLED=1
CLOUD_VOICE_ENABLED=1
STORY_SEARCH_PROVIDER=local
OPENSEARCH_API_KEY=
OPENSEARCH_ENDPOINT=
OPENSEARCH_WORKSPACE=default
TAVILY_API_KEY=
